{
  "name": "dia-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "build": "npm run check && node scripts/build.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-dia-workspace \"node --test tests/firestore.rules.test.mjs\""
  },
  "dependencies": {
    "firebase": "^13.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "^15.34.1",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
